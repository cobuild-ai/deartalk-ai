<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 🏛️ Cobuild AI 온디바이스 공통 모델 공유 전용 서명 권한 (동일 Keystore 보호) -->
    <permission
        android:name="ai.cobuild.permission.ACCESS_ONDEVICE_MODEL"
        android:protectionLevel="signature" />

    <uses-permission android:name="ai.cobuild.permission.ACCESS_ONDEVICE_MODEL" />

    <!-- Android 11+ (API 30+) On-Device Speech Recognition, TTS & Family Apps Package Visibility -->
    <queries>
        <package android:name="ai.deartalk.android" />
        <package android:name="ai.deartalk.translator" />
        <package android:name="ai.dearmind.android" />
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".DearTalkApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DearTalk">

        <!-- 🏛️ Cobuild AI 온디바이스 공통 모델 공유 프로바이더 (P2P Mesh) -->
        <provider
            android:name=".data.vault.CobuildModelProvider"
            android:authorities="${applicationId}.modelprovider"
            android:exported="true"
            android:readPermission="ai.cobuild.permission.ACCESS_ONDEVICE_MODEL" />

        <!-- 🏎️ Qualcomm Hexagon NPU DSP RPC Native Library (Zero Crash via required=false) -->
        <uses-native-library
            android:name="libcdsprpc.so"
            android:required="false" />

        <!-- 메인 설정 및 모델 다운로드 마법사 액티비티 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name"
            android:theme="@style/Theme.DearTalk">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>



        <!-- DearTalk IME Service (핵심 키보드 서비스) -->
        <service
            android:name=".ime.DearTalkIME"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

    </application>

</manifest>
